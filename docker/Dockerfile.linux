# Linux build + test of Oborcopy (Ubuntu 24.04 LTS ships Qt 6.4).
#   docker build -f docker/Dockerfile.linux -t oborcopy-linux .
FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build \
      qt6-base-dev qt6-base-dev-tools libgl1-mesa-dev patchelf \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt CMakePresets.json ./
COPY cmake ./cmake
COPY resources ./resources
COPY src ./src
COPY tests ./tests

RUN cmake --preset linux \
 && cmake --build --preset linux \
 && QT_QPA_PLATFORM=offscreen ctest --test-dir build/linux --output-on-failure

RUN cmake --install build/linux --prefix /out

# Self-contained package (Qt bundled) - extracted by scripts/deploy-linux.ps1.
COPY packaging ./packaging
COPY LICENSE ./
COPY docs/user-guide/Oborcopy-User-Guide.pdf ./docs/user-guide/
COPY docker/bundle-linux.sh ./docker/bundle-linux.sh
RUN sed -i 's/\r$//' docker/bundle-linux.sh \
 && bash docker/bundle-linux.sh /out /src /deploy

# systemd as PID 1 with the release package and the service test harness
# (scripts/test-linux-service.ps1 runs the real systemd user-service flow).
FROM build AS systemd-test
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus dbus-user-session \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash tester \
 && mkdir -p /home/tester/pkg \
 && tar xzf /deploy/oborcopy-*-linux-x86_64.tar.gz -C /home/tester/pkg \
 && cp build/linux/oborcopy-servicectl-test /home/tester/pkg/oborcopy-*/bin/ \
 && chown -R tester:tester /home/tester
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

# Minimal stage that only carries the binaries (extracted by scripts/build-linux.ps1).
FROM scratch AS artifacts
COPY --from=build /out/bin /

FROM scratch AS deploy
COPY --from=build /deploy /
