# Writes buildinfo.cpp with the current build date. The file is only rewritten
# when the date changes, so incremental builds stay incremental.
string(TIMESTAMP BUILD_DATE "%Y-%m-%d")

set(CONTENT "// Generated by cmake/BuildInfo.cmake - do not edit.
const char *oborcopyBuildDate() { return \"${BUILD_DATE}\"; }
")

set(OLD_CONTENT "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD_CONTENT)
endif()

if(NOT OLD_CONTENT STREQUAL CONTENT)
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
